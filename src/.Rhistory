t_test  = map(formula, ~ stats::t.test(.x, data = DT_ttest)),     # fit t-tests on log10-transformed data
t_stat  = map_dbl(t_test, "statistic"),                           # pull out t-statistic
P.Value = map_dbl(t_test, "p.value"),                             # pull out p-values
adj.P.Val = p.adjust(P.Value, method = "BH"),                     # FDR for multiple testing
# Calculate raw treatment and control means (from DT_ttest_raw)
treatment_estimate = map_dbl(AptName, ~ DT_ttest_raw |>
filter(SampleGroup == "treatment") |>
pull(.x) |> mean(na.rm = TRUE)),
control_estimate = map_dbl(AptName, ~ DT_ttest_raw |>
filter(SampleGroup == "control") |>
pull(.x) |> mean(na.rm = TRUE)),
# Calculate logFC (log2) from raw (non-transformed) means
logFC = log2(treatment_estimate / control_estimate)
) |>
arrange(adj.P.Val) |>           # re-order by adjusted p-value
mutate(rank = row_number())     # add rank based on adjusted p-value
